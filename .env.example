# Upper Left Indie — environment variables
#
# Copy to .env.local and fill in real values. Never commit .env.local.
# Everything here is server-only except the NEXT_PUBLIC_* entries at the bottom.

# --- Supabase ---------------------------------------------------------------
# Project URL and service role key. The service role key bypasses RLS: it must
# never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Anon key, used by the public shows page.
SUPABASE_ANON_KEY=
# Optional emergency brake for the free-tier Storage quota. Existing uploads
# and radio playback continue; only new MP3 upload URLs are paused.
# SUBMISSION_AUDIO_UPLOADS_ENABLED=false
# Not read by the app. The read-only Supabase MCP server in .mcp.json takes
# these from the shell that launches Claude Code, so export them there rather
# than putting them in .env.local. The token is account-wide; keep it private.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# --- Admin console ----------------------------------------------------------
# Password for /admin. ADMIN_API_TOKEN takes precedence if both are set.
# Without one of these, every admin route returns 500.
ADMIN_PASSWORD=
# ADMIN_API_TOKEN=

# --- Spotify ----------------------------------------------------------------
# From the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Generate by visiting /api/spotify/auth locally — see README.md.
SPOTIFY_REFRESH_TOKEN=
# Must exactly match a redirect URI registered on the Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Optional: defaults to the current public playlist id in src/lib/site.ts.
# SPOTIFY_ACTIVE_PLAYLIST_ID=
SPOTIFY_ARCHIVE_PLAYLIST_ID=

# --- Transactional email ----------------------------------------------------
# SMTP credentials used to send submission replies.
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
# Where contact-form messages are delivered.
RECIPIENT_EMAIL=
# Optional inbox overrides. By default the admin Inbox uses EMAIL_HOST with
# IMAP port 993, TLS enabled, the INBOX folder, and the same user/password.
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASS=
# EMAIL_IMAP_HOST=
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_SECURE=true
# EMAIL_IMAP_MAILBOX=INBOX
# EMAIL_IMAP_TIMEOUT_MS=15000

# --- AI reply drafts (optional) ---------------------------------------------
# Leave unset to use the defaults in src/lib/ai/. Drafting is optional; the
# admin console works without it.
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# OLLAMA_TIMEOUT_MS=90000
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Newsletter (optional) --------------------------------------------------
# MAILER_PROVIDER=mailerlite
# MAILER_API_KEY=
# MAILERLITE_API_KEY=

# --- Payments (optional) ----------------------------------------------------
# STRIPE_SECRET_KEY=

# --- Public (exposed to the browser — never put a secret here) ---------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
